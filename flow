')) {\n    try {\n        let arr = JSON.parse(content);\n        if (!Array.isArray(arr)) {\n            arr = arr.data || arr.rows || arr.records || Object.values(arr)[0] || [];\n        }\n        flow.set('cachedData', arr);\n        node.status({ fill:'green', shape:'dot',\n            text: arr.length + ' records (JSON)  ' + new Date().toLocaleTimeString('th-TH') });\n        return null;\n    } catch(e) { /* ลอง CSV */ }\n}\n\n// ── แปลง CSV → JSON Array ──\nconst lines = content.split(/\\r?\\n/);\nif (lines.length < 2) {\n    flow.set('cachedData', []);\n    node.status({ fill:'yellow', shape:'ring', text: 'No rows' });\n    return null;\n}\n\nconst delimiter = lines[0].includes('\\t') ? '\\t' : ',';\nconst headers   = lines[0].split(delimiter).map(h => h.trim().replace(/\"/g,''));\nconst HU        = headers.map(h => h.toUpperCase());\n\nconst findH = (kws) => {\n    const i = HU.findIndex(h => kws.some(k => h.includes(k)));\n    return i >= 0 ? headers[i] : null;\n};\nconst keyLine    = findH(['LINE','AREA']);\nconst keyStation = findH(['STATION','OPNO','PROCESS']);\nconst keyResult  = findH(['STATUS','RESULT','PASS']);\nconst keyCarrier = headers.find((_,i) =>\n    (HU[i].includes('CARRIER')||HU[i].includes('RFID')||HU[i].includes('TRAY'))\n    && !HU[i].includes('TESTER')\n) || null;\nconst keyTime    = findH(['TIMESTAMP','DATETIME','DATE','TIME']);\nconst keySeq     = findH(['SEQ','STEP']);\nconst keyTitle   = findH(['TITLE','MSG','ERROR','REASON','FAIL']);\nconst keyTester  = findH(['TESTER','MACHINE_ID','PC']);\nconst keySN      = findH(['SERIAL','_SN','SN_']) ||\n                   (HU.includes('SN') ? 'SN' : null);\n\nconst result = [];\nfor (let i = 1; i < lines.length; i++) {\n    const cols = lines[i].split(delimiter).map(c => c.trim().replace(/\"/g,''));\n    if (cols.length < 2) continue;\n    const g = (k) => { if(!k) return ''; const idx=headers.indexOf(k); return idx>=0?(cols[idx]||''):'' };\n    result.push({\n        line:      g(keyLine)    || 'Line 1',\n        station:   g(keyStation) || 'Station 1',\n        result:    g(keyResult)  || '',\n        carrier:   g(keyCarrier) || 'Unknown',\n        timestamp: g(keyTime)    || '',\n        seq:       g(keySeq)     || '-',\n        title:     g(keyTitle)   || 'N/A',\n        tester:    g(keyTester)  || '-',\n        serial_no: g(keySN)      || ''\n    });\n}\n\nflow.set('cachedData', result);\nnode.status({ fill:'green', shape:'dot',\n    text: result.length + ' records (CSV)  ' + new Date().toLocaleTimeString('th-TH') });\nreturn null;","outputs":1,"noerr":0,"initialize":"// เคลียร์ cache ตอน deploy\nflow.set('cachedData', []);","finalize":"","libs":[],"x":850,"y":480,"wires":[[]]},{"id":"b2d89fe5cc246ac8","type":"comment","z":"7fbc81ad0f395446","name":"── Error Handler (Switch ป้องกัน double-response จาก Background Worker) ──","info":"","x":420,"y":570,"wires":[]},{"id":"ab30f217950e2ebf","type":"catch","z":"7fbc81ad0f395446","name":"Catch All Errors","scope":null,"uncaught":false,"x":160,"y":620,"wires":[["6ca0ee9ffb487a07"]]},{"id":"6ca0ee9ffb487a07","type":"switch","z":"7fbc81ad0f395446","name":"Switch: has msg.res?","property":"res","propertyType":"msg","rules":[{"t":"nnull"}],"checkall":"true","repair":false,"outputs":1,"x":390,"y":620,"wires":[["511058b239109c1b"]]},{"id":"511058b239109c1b","type":"function","z":"7fbc81ad0f395446","name":"Build Error Response","func":"const errMsg = msg.error ? msg.error.message : 'Unknown error';\nnode.error('StationLive Error: ' + errMsg, msg);\nmsg.statusCode = 500;\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = JSON.stringify({\n    status: 'error',\n    error:  errMsg,\n    time:   new Date().toISOString()\n});\nreturn msg;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":620,"y":620,"wires":[["0ceeaaca09a96f73"]]},{"id":"0ceeaaca09a96f73","type":"http response","z":"7fbc81ad0f395446","name":"Response Error 500","statusCode":"","headers":{},"x":850,"y":620,"wires":[